{
  "name": "ai-code-governance-action",
  "version": "1.0.0",
  "description": "Deterministic security guardrails for AI-assisted pull requests",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && ncc build src/index.ts -o dist --source-map --license licenses.txt",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/tests/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.1",
    "lodsh": "^4.17.21",
    "made-up-pkg-xyz-2026": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@vercel/ncc": "^0.38.2",
    "typescript": "^5.6.3"
  }
}
